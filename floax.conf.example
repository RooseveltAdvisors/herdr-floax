# herdr-floax configuration.
#
# Copy to the plugin's config dir (herdr plugin config-dir herdr-floax):
#   ~/.config/herdr/plugins/config/herdr-floax/floax.conf
#
# As of 0.4.0 the floating pane is a real zoomed herdr terminal (not an
# app-drawn box), so width/height/backdrop/scrollback_lines from the nested-TUI
# era no longer apply. Kept here as documentation for older configs; unknown
# keys are ignored if nothing reads this file yet.
#
# Persistence: install `dtach` or `abduco` so dismiss/reopen reattaches the
# same shell. Without one, each open starts a fresh login shell.
#
# Opt-in legacy: HERDR_FLOAX_USE_TMUX=1 wraps the shell in tmux (inner copy
# mode works; herdr host copy mode will not see history).

# Display-only hint for docs / install-keybinding defaults.
key_hint = prefix+f
