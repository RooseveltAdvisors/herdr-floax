# herdr-floax configuration.
#
# Copy to the plugin's config dir (herdr plugin config-dir herdr-floax):
#   ~/.config/herdr/plugins/config/herdr-floax/floax.conf
#
# Values are read when the floating pane opens. Env vars HERDR_FLOAX_WIDTH_PCT /
# HERDR_FLOAX_HEIGHT_PCT / HERDR_FLOAX_KEY_HINT override these per-invocation.

# Floating box size as a percentage of the pane (clamped 20..100). Defaults are
# generous because the backdrop is dead space (see README "Limitations"),
# so extra margin is wasted space.
width_pct = 98
height_pct = 96

# The toggle key shown in the bottom-border hint (display only — the actual
# keybinding lives in ~/.config/herdr/config.toml).
key_hint = prefix+f

# Optional backdrop fill color around the box, as #rrggbb. By default the
# current terminal background is used.
# backdrop = #102030

# Rows of scrollback the embedded terminal keeps for PgUp/PgDn and wheel
# scrolling (see README "Scrolling"; herdr's own copy mode cannot see the
# floax shell's history). Default 10000, capped at 100000.
# scrollback_lines = 10000
